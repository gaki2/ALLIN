{
  "name": "Rig",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "turbo dev --concurrency=15",
    "dev:doc": "turbo dev --filter=docs",
    "dev:app": "turbo dev --filter=desktop-app...",
    "start": "turbo start",
    "build": "turbo build",
    "test": "pnpm -r --filter \"./apps/**\" --filter \"./packages/**\" --if-present --stream test:watch",
    "test:once": "pnpm -r --filter \"./apps/**\" --filter \"./packages/**\" --if-present --stream test",
    "check-ts:app": "pnpm -r --filter \"./apps/tauri/**\" --if-present --stream check-ts",
    "check-ts": "pnpm -r --filter \"./apps/**\" --filter \"./packages/**\" --if-present --stream check-ts",
    "new-extension": "node scripts/new-extension.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "catalog:lint",
    "@ladle/react": "catalog:dev",
    "husky": "^9.1.7",
    "inquirer": "catalog:cli",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "rimraf": "catalog:build",
    "tsup": "catalog:build",
    "turbo": "catalog:cli",
    "typescript": "catalog:types"
  },
  "packageManager": "pnpm@9.6.0",
  "pnpm": {
    "overrides": {
      "@pierre/diffs>shiki": "4.4.1"
    }
  }
}
